# Unframed — Environment Configuration (All fields are optional!)
# By default, Unframed automatically discovers Samsung The Frame TVs on your LAN.

# Optional: Pin a specific Frame TV IP (leave blank for automatic LAN discovery)
FRAME_TV_IP=

# Optional: Override /24 subnet to scan during LAN auto-discovery (e.g. 192.168.1.0/24)
FRAME_TV_SUBNET=

# Optional: TLS WebSocket port on the TV (default: 8002)
FRAME_TV_PORT=8002

# Optional: Client name shown on the TV pairing prompt (plain text or base64)
FRAME_TV_WS_NAME=Unframed

# Optional: Pre-paired TV token (leave blank on first run to pair via TV remote,
# and Unframed will automatically save the token to the data volume)
FRAME_TV_TOKEN=

# Optional: Host port to bind (default: 8094)
PORT=8094
TZ=UTC
